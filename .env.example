# Use your own accounts and Supabase project. Never commit real values.
OPENAI_API_KEY=your-own-key
OPENAI_MODEL=a-model-your-account-can-use-with-tool-calling
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your-own-secret-or-service-role-key
SUPABASE_DB_URI=postgresql://postgres.YOUR_PROJECT:ENCODED_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
# Optional LangSmith tracing; leave these out to keep tracing off.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-own-langsmith-key
# LANGSMITH_PROJECT=inventory-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
